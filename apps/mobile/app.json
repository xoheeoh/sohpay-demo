{
  "expo": {
    "name": "SohPay",
    "slug": "sohpay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sohpay",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.sohpay.demo",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "가맹점 QR 코드를 스캔해 결제하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryAddUsageDescription": "결제 내역 이미지를 사진에 저장하기 위해 사용합니다."
      }
    },
    "android": {
      "package": "app.sohpay.demo",
      "adaptiveIcon": {
        "backgroundColor": "#1E63F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "name": "SohPay | 충전하고, 스캔하고, 끝.",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "가맹점 QR 코드를 스캔해 결제하기 위해 카메라를 사용합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "결제 내역 이미지를 사진에 저장하기 위해 사용합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E63F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ca6c3467-2a2c-473f-8044-528a506ee2ee"
      }
    }
  }
}
