{
  "expo": {
    "name": "SohPay",
    "slug": "sohpay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sohpay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.sohpay.demo",
      "supportsTablet": false,
      "infoPlist": { "NSCameraUsageDescription": "가맹점 QR 코드를 스캔해 결제하기 위해 카메라를 사용합니다." }
    },
    "android": {
      "package": "app.sohpay.demo",
      "adaptiveIcon": {
        "backgroundColor": "#1E63F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "가맹점 QR 코드를 스캔해 결제하기 위해 카메라를 사용합니다." }],
      ["expo-splash-screen", { "backgroundColor": "#1E63F0", "image": "./assets/images/splash-icon.png", "imageWidth": 76 }]
    ],
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}
