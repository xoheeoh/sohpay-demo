# 로컬 Supabase 는 `supabase status` 에서 확인. 원격은 프로젝트 설정 > API.
# 실기기에서 로컬 스택을 쓰려면 127.0.0.1 대신 PC 의 LAN IP 를 넣는다.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# (선택) 개발 중 특정 화면만 바로 열어 볼 때 시작 화면 이름. 예: JoinCompleted
# 비워 두면 평소처럼 로그인/홈에서 시작한다. 배포 빌드에서는 무시된다.
EXPO_PUBLIC_DEV_START_SCREEN=
