# Supabase 프로젝트의 값을 넣는다. (대시보드 Project Settings → Data API / API Keys)
#   URL      : https://<ref>.supabase.co
#   ANON KEY : anon / public 키 (service_role 은 절대 넣지 않는다)
# 로컬 Docker 스택을 쓸 때만 http://127.0.0.1:54321 과 로컬 anon key 를 넣는다.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
